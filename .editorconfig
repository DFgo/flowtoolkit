# EditorConfig 帮助维护跨编辑器的一致性编码风格
# https://editorconfig.org

root = true

# 所有文件
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript 文件
[*.js]
indent_style = space
indent_size = 2

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false

# YML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# 配置文件
[{package.json,.eslintrc*,.prettierrc*}]
indent_style = space
indent_size = 2
